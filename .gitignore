# OS / editor cruft
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*.swp
*~
.vscode/
.idea/

# Node, if a build or test setup is ever added
node_modules/
npm-debug.log*
yarn-error.log*
package-lock.json.bak

# Local scratch
tmp/
scratch/
*.local.html

# Sliced intermediates, regenerate with tools/slice-strips.py
artwork/basketball-players/* frames/
# Screenshots the Claude desktop app drops into the folder
Claude outputs/

# Audio: the game uses the 16-bit WAVs. Everything else in audio/ is an
# audition aid or a second copy, and tools/build-*.py regenerates all of it.
audio/basketball-arcade/
audio/**/pcm8/
audio/**/*-pcm8.wav
audio/**/*.zip
audio/**/preview.html
audio/**/preview.wav
audio/**/loop-seam-preview.wav
audio/**/victory-sequence-preview.wav
audio/**/score.json
audio/**/validation.json

# Tarballs staged out to the cloud workspace, and Python bytecode
_stage/
__pycache__/

# audio/sfx-data.js and the .flac tracks ARE committed: they are what the game
# loads. The .wav sources stay too, as the fallback and as what the build
# scripts produce.

# Rendered generation prompts. art/sequences.yml and art/characters.yml are the
# source of truth and tools/gen-prompts.py rebuilds every prompt from them, so
# the rendered copies are as disposable as any other build output.
build/

# The signed-in ChatGPT browser profile used by tools/gen-strips.py. This holds
# live session cookies for Rick's account -- it must never be committed.
.chatgpt-profile/
